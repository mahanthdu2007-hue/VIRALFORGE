# ViralForge AI 2.0 — environment template.
# Copy to `.env.local` and fill in. Never commit real secrets.

# ---------------------------------------------------------------------------
# AI providers (Phase 2+). Leave blank in Phase 1: the app runs on the mock
# provider and reports which real providers are configured.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=

# Which provider the AI abstraction resolves. Implemented: mock, openai, nvidia.
# Both `openai` and `nvidia` are complete providers: each supplies transcription,
# clip discovery and clip refinement on its own, so exactly one key is needed.
# `openai` requires OPENAI_API_KEY, `nvidia` requires NVIDIA_API_KEY — and
# `nvidia` never reads OPENAI_API_KEY. There is no silent fallback to mock.
AI_PROVIDER=mock

# OpenAI model names. Overridable so a model rename needs no code change.
# Transcription needs a model that supports verbose_json with word timestamps.
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_DISCOVERY_MODEL=gpt-4o-mini

# Clip discovery and refinement, over NVIDIA's OpenAI-compatible chat endpoint
# (https://integrate.api.nvidia.com/v1). Refinement deliberately shares this
# model: it is the same judgement over the same transcript text.
NVIDIA_DISCOVERY_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Transcription. Parakeet TDT 0.6B v2 is NVIDIA's English ASR model with
# punctuation and word-level timestamps.
NVIDIA_TRANSCRIPTION_MODEL=nvidia/parakeet-tdt-0.6b-v2

# Where the ASR model is reached. NVIDIA hosts Parakeet as a Riva NVCF *gRPC*
# function — integrate.api.nvidia.com serves chat and embeddings only and has no
# /v1/audio/transcriptions route — so this is a `host:port`, not a URL. Point it
# at your own Riva Speech NIM to run transcription locally.
NVIDIA_ASR_ENDPOINT=grpc.nvcf.nvidia.com:443

# NVCF function id for the ASR model. Leave blank for a model the app already
# knows (NVIDIA_TRANSCRIPTION_MODEL's default is one); set it when you point
# NVIDIA_TRANSCRIPTION_MODEL at a model or deployment the app has no id for.
NVIDIA_ASR_FUNCTION_ID=

# ---------------------------------------------------------------------------
# Media toolchain
# ---------------------------------------------------------------------------
# Leave blank to resolve `ffmpeg` / `ffprobe` from PATH, or give absolute paths.
FFMPEG_PATH=
FFPROBE_PATH=

# ---------------------------------------------------------------------------
# Storage — uploads and rendered output live on the local filesystem.
# Relative paths resolve against the project root.
# ---------------------------------------------------------------------------
STORAGE_DIR=storage

# Largest accepted upload, in megabytes.
MAX_UPLOAD_MB=2048

# SQLite file, relative to STORAGE_DIR. Use `:memory:` for an ephemeral database.
DATABASE_FILE=viralforge.db

# ---------------------------------------------------------------------------
# Jobs
# ---------------------------------------------------------------------------
# Analysis jobs allowed to run at once. Each one owns an FFmpeg process; 1 is
# the right answer on a 16 GB machine.
JOB_CONCURRENCY=1

# Upper bound on moments discovery may return per video.
MAX_CANDIDATES=12

# ---------------------------------------------------------------------------
# Subject tracking — what the 9:16 crop follows.
#
#   center     Deterministic: assumes the subject is in the middle. Needs
#              nothing installed, and is the default.
#   face       Real detection: YuNet face detector, run locally on the CPU.
#              Needs `npm i onnxruntime-node` and the weights:
#                  node scripts/fetch-subject-model.mjs
#   luminance  Brightest-region saliency. No model, no native runtime; only
#              useful on high-contrast footage.
#   none       Never track; every clip gets a centre crop.
#
# Anything that cannot run degrades to `center` and says so in the log. No
# frame is ever uploaded anywhere: all inference is local.
# ---------------------------------------------------------------------------
SUBJECT_TRACKER=center

# Weights for `face`. Blank means <STORAGE_DIR>/models/face_detection_yunet_2023mar.onnx.
SUBJECT_DETECTOR_MODEL_PATH=

# Frames sampled per second of source. The main cost lever: 2 fps is ~20 ms of
# inference per sampled frame, and the crop path smooths between them anyway.
SUBJECT_DETECTOR_FPS=2

# Hard ceiling on sampled frames per clip, so a long range cannot run away.
SUBJECT_DETECTOR_MAX_FRAMES=240

# Longest edge a frame is decoded at. Detection gains little above this.
SUBJECT_DETECTOR_MAX_EDGE_PX=640

# Detections below this are not treated as a subject.
SUBJECT_DETECTOR_MIN_CONFIDENCE=0.6

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info
